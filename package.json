{
  "name": "driftbrief",
  "version": "0.1.0-beta.2",
  "description": "A compact, current project map for game-coding agents.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "bin": {
    "driftbrief": "run.mjs"
  },
  "files": [
    "run.mjs",
    "assets",
    "README.md",
    "LICENSE",
    "docs",
    "evals"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && tsx --test --test-concurrency=1 tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "demo": "node scripts/demo.mjs",
    "bench": "node run.mjs bench",
    "release:local": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.2",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ignore": "^7.0.5",
    "jsonc-parser": "^3.3.1",
    "proper-lockfile": "^4.1.2",
    "web-tree-sitter": "0.27.0",
    "zod": "^3.25.76",
    "playwright-core": "^1.58.0"
  },
  "repository": {
    "url": "git+https://github.com/KrushnaChaudhary/driftbrief.git",
    "type": "git"
  },
  "homepage": "https://krushnachaudhary.github.io/driftbrief/",
  "bugs": {
    "url": "https://github.com/KrushnaChaudhary/driftbrief/issues"
  }
}